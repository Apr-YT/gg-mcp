<?xml version="1.0" encoding="utf-8"?>
<!-- 保存列表页（GG 保存列表风格）：顶部操作栏 + 6 列列表 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:padding="6dp">

    <!-- 顶部操作栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnSaveAdd"
            style="@style/GGBtnPrimary"
            android:text="+添加" />
        <TextView
            android:id="@+id/btnSaveClear"
            style="@style/GGBtn"
            android:layout_marginLeft="4dp"
            android:text="清除" />
        <TextView
            android:id="@+id/btnSaveFreezeAll"
            style="@style/GGBtn"
            android:layout_marginLeft="4dp"
            android:text="全冻" />
        <TextView
            android:id="@+id/btnSaveUnfreezeAll"
            style="@style/GGBtn"
            android:layout_marginLeft="4dp"
            android:text="全解冻" />
        <TextView
            android:id="@+id/btnSaveMore"
            style="@style/GGBtn"
            android:layout_marginLeft="4dp"
            android:text="更多▼" />
    </LinearLayout>

    <!-- 6 列表头 -->
    <LinearLayout
        style="@style/GGHeader"
        android:layout_marginTop="4dp">

        <TextView style="@style/GGHeaderText" android:layout_width="28dp" android:text="☐" />
        <TextView style="@style/GGHeaderText" android:layout_width="0dp" android:layout_weight="1.5" android:text="描述" />
        <TextView style="@style/GGHeaderText" android:layout_width="0dp" android:layout_weight="1" android:text="地址" />
        <TextView style="@style/GGHeaderText" android:layout_width="0dp" android:layout_weight="0.8" android:text="值" />
        <TextView style="@style/GGHeaderText" android:layout_width="0dp" android:layout_weight="0.5" android:text="类型" />
        <TextView style="@style/GGHeaderText" android:layout_width="28dp" android:text="冻结" />
    </LinearLayout>

    <ListView
        android:id="@+id/saveList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/card"
        android:divider="@color/divider"
        android:dividerHeight="1dp" />

    <TextView
        android:id="@+id/saveInfo"
        style="@style/GGInfo"
        android:text="点击行: 修改值   长按: 编辑描述/删除" />
</LinearLayout>
