<?xml version="1.0" encoding="utf-8"?>
<!-- 搜索面板（GG 风格）：顶部控件可滚动（更多▼ 展开不挤列表），结果列表保底 40% 空间，refine 固定底部 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:padding="6dp">

    <!-- 顶部控件区（可滚动：展开高级选项后滚动查看，不挤压结果列表） -->
    <ScrollView
        android:id="@+id/topScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 大输入框 -->
            <EditText
                android:id="@+id/edValue"
                style="@style/GGInputBig"
                android:hint="输入搜索值" />

            <!-- 搜索按钮行 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/btnSearch"
                    style="@style/GGBtnPrimary"
                    android:text="搜索" />
                <TextView
                    android:id="@+id/btnReset"
                    style="@style/GGBtn"
                    android:layout_marginLeft="4dp"
                    android:text="重置" />
                <TextView
                    android:id="@+id/btnMore"
                    style="@style/GGBtn"
                    android:layout_marginLeft="4dp"
                    android:text="更多▼" />
            </LinearLayout>

            <!-- 类型横向滚动小方块 -->
            <HorizontalScrollView
                android:id="@+id/typeScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/typeRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView android:id="@+id/type0" style="@style/GGType" android:text="BYTE" />
                    <TextView android:id="@+id/type1" style="@style/GGType" android:text="WORD" />
                    <TextView android:id="@+id/type2" style="@style/GGType" android:text="DWORD" />
                    <TextView android:id="@+id/type3" style="@style/GGType" android:text="QWORD" />
                    <TextView android:id="@+id/type4" style="@style/GGType" android:text="FLOAT" />
                    <TextView android:id="@+id/type5" style="@style/GGType" android:text="DOUBLE" />
                    <TextView android:id="@+id/type6" style="@style/GGType" android:text="AUTO" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- 高级选项（更多▼ 展开） -->
            <LinearLayout
                android:id="@+id/advancedRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="4dp"
                android:background="@drawable/card_bg"
                android:padding="4dp"
                android:visibility="gone">

                <!-- 内存范围 + 对齐 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        style="@style/GGHeaderText"
                        android:text="范围:" />
                    <Spinner
                        android:id="@+id/regionSpinner"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_weight="1"
                        android:layout_marginLeft="4dp"
                        android:background="@drawable/edit_bg"
                        android:gravity="center_vertical"
                        android:paddingLeft="6dp"
                        android:paddingRight="6dp" />
                    <TextView
                        style="@style/GGHeaderText"
                        android:layout_marginLeft="8dp"
                        android:text="对齐:" />
                    <Spinner
                        android:id="@+id/alignSpinner"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_weight="1"
                        android:layout_marginLeft="4dp"
                        android:background="@drawable/edit_bg"
                        android:gravity="center_vertical"
                        android:paddingLeft="6dp"
                        android:paddingRight="6dp" />
                </LinearLayout>

                <!-- 搜索模式 + 区间 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical">

                    <TextView
                        style="@style/GGHeaderText"
                        android:text="模式:" />
                    <TextView
                        android:id="@+id/btnModeExact"
                        style="@style/GGBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="0"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:text="精确" />
                    <TextView
                        android:id="@+id/btnModeFuzzy"
                        style="@style/GGBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="0"
                        android:layout_marginLeft="4dp"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:text="模糊" />

                    <EditText
                        android:id="@+id/edMin"
                        style="@style/GGEdit"
                        android:layout_marginLeft="8dp"
                        android:hint="min"
                        android:textSize="12sp" />
                    <EditText
                        android:id="@+id/edMax"
                        style="@style/GGEdit"
                        android:layout_marginLeft="4dp"
                        android:hint="max"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/btnRange"
                        style="@style/GGBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="0"
                        android:layout_marginLeft="4dp"
                        android:paddingLeft="8dp"
                        android:paddingRight="8dp"
                        android:text="区间" />
                </LinearLayout>
            </LinearLayout>

            <!-- 提示/空态 -->
            <TextView
                android:id="@+id/infoText"
                style="@style/GGInfo"
                android:text="搜索结果将显示在这里" />
        </LinearLayout>
    </ScrollView>

    <!-- 结果列表（5 列，保底 40% 高度） -->
    <ListView
        android:id="@+id/resultList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:background="@color/card"
        android:divider="@color/divider"
        android:dividerHeight="1dp" />

    <!-- refine 四键（有结果时显示，固定底部） -->
    <LinearLayout
        android:id="@+id/refineRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/opIncreased"
            style="@style/GGBtn"
            android:text="+增加" />
        <TextView
            android:id="@+id/opDecreased"
            style="@style/GGBtn"
            android:layout_marginLeft="4dp"
            android:text="-减少" />
        <TextView
            android:id="@+id/opUnchanged"
            style="@style/GGBtn"
            android:layout_marginLeft="4dp"
            android:text="=未变" />
        <TextView
            android:id="@+id/opChanged"
            style="@style/GGBtn"
            android:layout_marginLeft="4dp"
            android:text="≠变化" />
    </LinearLayout>
</LinearLayout>
