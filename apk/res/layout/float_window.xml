<?xml version="1.0" encoding="utf-8"?>
<!-- 悬浮窗主容器（GG 风格）：标题栏(可拖动) + 4 标签 + 内容区 + 底部状态栏 + 顶部浮动通知层 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/floatWindow"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/float_bg">

    <!-- 主列 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 标题栏（拖动整个悬浮窗）：GG 图标+文字 | 进程名 | 最小化 | 关闭 -->
        <LinearLayout
            android:id="@+id/titleBar"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/titlebar"
            android:paddingLeft="8dp"
            android:paddingRight="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="GG"
                android:textColor="@color/text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/titleText"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginLeft="8dp"
                android:gravity="center_vertical"
                android:ellipsize="middle"
                android:maxLines="1"
                android:text="未选择进程"
                android:textColor="@color/text"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnHideWindow"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:text="_"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnCloseWindow"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingLeft="12dp"
                android:paddingRight="10dp"
                android:text="X"
                android:textColor="@color/text"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 标签栏（4 个均分） -->
        <LinearLayout
            android:id="@+id/tabBar"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:background="@color/bg">

            <TextView android:id="@+id/tabSearch" style="@style/GGTab" android:text="搜索" />
            <TextView android:id="@+id/tabMemory" style="@style/GGTab" android:text="内存" />
            <TextView android:id="@+id/tabSave" style="@style/GGTab" android:text="保存" />
            <TextView android:id="@+id/tabSettings" style="@style/GGTab" android:text="设置" />
        </LinearLayout>

        <!-- 内容区 -->
        <FrameLayout
            android:id="@+id/contentArea"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 底部状态栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/bg">

            <TextView
                android:id="@+id/statusResult"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:paddingLeft="10dp"
                android:text="结果: 0"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/statusSelected"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="已选: 0"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/statusFrozen"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:paddingRight="4dp"
                android:gravity="end|center_vertical"
                android:text="冻结: 0"
                android:textColor="@color/green"
                android:textSize="11sp" />

            <!-- 右下角缩放手柄（拖动调整窗口大小） -->
            <TextView
                android:id="@+id/btnResize"
                android:layout_width="30dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="◢"
                android:textColor="@color/primary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 顶部浮动通知层（默认隐藏，代码控制滑入/滑出） -->
    <TextView
        android:id="@+id/notifBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:background="@drawable/notif_cmd_bg"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text=""
        android:textColor="@color/text"
        android:textSize="12sp"
        android:visibility="gone" />
</FrameLayout>
