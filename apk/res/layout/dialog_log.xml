<?xml version="1.0" encoding="utf-8"?>
<!-- 操作日志对话框：过滤 + 清空/导出 + 实时列表（设置页入口，日志不再占标签位） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <CheckBox android:id="@+id/filterAll" android:text="全部"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/text_secondary" android:textSize="12sp"
            android:checked="true" android:buttonTint="@color/primary" />
        <CheckBox android:id="@+id/filterCmd" android:text="命令"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/text_secondary" android:textSize="12sp"
            android:checked="true" android:buttonTint="@color/primary" />
        <CheckBox android:id="@+id/filterBp" android:text="断点"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/text_secondary" android:textSize="12sp"
            android:checked="true" android:buttonTint="@color/primary" />
        <CheckBox android:id="@+id/filterAnnot" android:text="标注"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/text_secondary" android:textSize="12sp"
            android:checked="true" android:buttonTint="@color/primary" />

        <TextView
            android:id="@+id/btnExportLog"
            style="@style/GGBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="0"
            android:layout_marginLeft="4dp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:text="导出" />
        <TextView
            android:id="@+id/btnClearLog"
            style="@style/GGBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="0"
            android:layout_marginLeft="4dp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:text="清空" />
    </LinearLayout>

    <ListView
        android:id="@+id/logList"
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:layout_marginTop="4dp"
        android:background="@color/card"
        android:divider="@color/divider"
        android:dividerHeight="1dp" />

    <TextView
        android:id="@+id/logInfo"
        style="@style/GGInfo"
        android:text="等待 AI 操作事件…（电脑端 AI 通过 MCP 操作时实时显示）" />
</LinearLayout>
