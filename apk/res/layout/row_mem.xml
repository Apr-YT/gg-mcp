<?xml version="1.0" encoding="utf-8"?>
<!-- 内存行（16 字节）：断点红点 | 地址 | hex | ASCII -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:minHeight="28dp"
    android:paddingLeft="4dp"
    android:paddingRight="4dp"
    android:background="@drawable/row_press_bg">

    <View
        android:id="@+id/memBpDot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginRight="2dp"
        android:background="@drawable/bp_dot"
        android:visibility="gone" />

    <TextView
        android:id="@+id/memRowAddr"
        android:layout_width="90dp"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:textColor="@color/addr"
        android:textSize="11sp"
        android:shadowColor="#6688CCCC"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="6"
        android:text="" />

    <TextView
        android:id="@+id/memRowHex"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2"
        android:fontFamily="monospace"
        android:textColor="@color/hex"
        android:textSize="11sp"
        android:shadowColor="#66AAFFAA"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="6"
        android:text="" />

    <TextView
        android:id="@+id/memRowAscii"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFamily="monospace"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:text="" />
</LinearLayout>
