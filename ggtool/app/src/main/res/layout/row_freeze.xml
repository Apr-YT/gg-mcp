<?xml version="1.0" encoding="utf-8"?>
<!-- 冻结列表条目：状态点 + 地址 + 值/类型/状态 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/row_bg"
    android:minHeight="@dimen/row_height"
    android:paddingLeft="@dimen/spacing_sm"
    android:paddingRight="@dimen/spacing_sm">

    <View
        android:id="@+id/v_status_dot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginRight="@dimen/spacing_sm"
        android:background="@drawable/dot_green" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/addr"
            android:textSize="@dimen/text_sm" />

        <TextView
            android:id="@+id/tv_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_xs" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:textColor="@color/green"
        android:textSize="@dimen/text_xs" />

    <Button
        android:id="@+id/btn_toggle"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/touch_min"
        android:minWidth="@dimen/touch_min"
        android:background="@drawable/btn_dark"
        android:text="@string/status_frozen"
        android:textColor="@color/text"
        android:textSize="@dimen/text_xs" />

</LinearLayout>
