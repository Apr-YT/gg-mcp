<?xml version="1.0" encoding="utf-8"?>
<!-- 保存列表条目：地址/值 + 冻结/删除 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/row_bg"
    android:minHeight="@dimen/row_height"
    android:paddingLeft="@dimen/spacing_sm"
    android:paddingRight="@dimen/spacing_sm">

    <CheckBox
        android:id="@+id/cb_select"
        android:layout_width="@dimen/touch_min"
        android:layout_height="@dimen/touch_min"
        android:button="@android:drawable/checkbox_off_background" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingLeft="@dimen/spacing_sm">

        <TextView
            android:id="@+id/tv_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/addr"
            android:textSize="@dimen/text_sm" />

        <TextView
            android:id="@+id/tv_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/hex"
            android:textSize="@dimen/text_md"
            android:textStyle="bold" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_freeze"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/touch_min"
        android:minWidth="@dimen/touch_min"
        android:background="@drawable/btn_dark"
        android:text="@string/menu_freeze"
        android:textColor="@color/text"
        android:textSize="@dimen/text_xs" />

    <ImageButton
        android:id="@+id/btn_delete"
        android:layout_width="@dimen/touch_min"
        android:layout_height="@dimen/touch_min"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/delete_confirm"
        android:src="@android:drawable/ic_menu_delete" />

</LinearLayout>
