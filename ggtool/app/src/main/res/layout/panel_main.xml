<?xml version="1.0" encoding="utf-8"?>
<!-- 主悬浮面板：GG 风格（顶部图标+书签tab+关闭 / 信息行 / 快捷工具栏 / 内容区 / 底部状态栏） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/panel_bg">

    <!-- ═══ 顶部行：游戏图标 + 书签 tab + 关闭 ═══ -->
    <LinearLayout
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_height"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/titlebar">

        <!-- 左上角：游戏图标（点击可换，第一阶段显示 GG 图标） -->
        <ImageButton
            android:id="@+id/btn_app_icon"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/app_name"
            android:padding="@dimen/icon_padding"
            android:src="@drawable/ic_gg" />

        <!-- 中间：书签 tab 导航 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_tab_search"
                style="@style/GgTab"
                android:text="@string/tab_search" />

            <TextView
                android:id="@+id/btn_tab_saved"
                style="@style/GgTab"
                android:text="@string/tab_saved" />

            <TextView
                android:id="@+id/btn_tab_freeze"
                style="@style/GgTab"
                android:text="@string/tab_freeze" />
        </LinearLayout>

        <!-- 右上角：关闭按钮 -->
        <ImageButton
            android:id="@+id/btn_close"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close"
            android:padding="@dimen/icon_padding"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <!-- ═══ 信息行：暂停 / 应用名 / 结果数 / 刷新 ═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/bg"
        android:paddingLeft="@dimen/spacing_sm"
        android:paddingRight="@dimen/spacing_sm">

        <ImageButton
            android:id="@+id/btn_pause"
            android:layout_width="32dp"
            android:layout_height="26dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_pause" />

        <TextView
            android:id="@+id/tv_app_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:paddingLeft="@dimen/spacing_sm"
            android:text="@string/app_name"
            android:textColor="@color/text"
            android:textSize="@dimen/text_sm" />

        <TextView
            android:id="@+id/tv_result_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:paddingLeft="@dimen/spacing_sm"
            android:paddingRight="@dimen/spacing_sm"
            android:text="(0)"
            android:textColor="@color/addr"
            android:textSize="@dimen/text_sm" />

        <ImageButton
            android:id="@+id/btn_refresh"
            android:layout_width="32dp"
            android:layout_height="26dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/clear_selection"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_refresh" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider_height"
        android:background="@color/divider" />

    <!-- ═══ 快捷工具栏（上下文相关按钮由代码填充）═══ -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/card"
        android:paddingLeft="@dimen/spacing_sm"
        android:paddingRight="@dimen/spacing_sm">

        <LinearLayout
            android:id="@+id/toolbar_search"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/toolbar_saved"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/toolbar_freeze"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider_height"
        android:background="@color/divider" />

    <!-- ═══ 内容区 ═══ -->
    <FrameLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- ═══ 底部状态栏：版本 + 眼睛（长按透视）═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/card"
        android:paddingLeft="@dimen/spacing_md"
        android:paddingRight="@dimen/spacing_sm">

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:text="GG Tool 1.0"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_xs" />

        <ImageButton
            android:id="@+id/btn_eye"
            android:layout_width="@dimen/touch_min"
            android:layout_height="30dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/drag_hint"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_eye" />
    </LinearLayout>

</LinearLayout>
