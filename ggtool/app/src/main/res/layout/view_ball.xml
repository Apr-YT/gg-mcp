<?xml version="1.0" encoding="utf-8"?>
<!-- GG 风格悬浮球：减速箭头 + 图标 + 加速箭头 + 速度文本（对应 GG hot_point_view） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@drawable/ball_bg"
    android:padding="@dimen/spacing_xs">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- 减速（左箭头） -->
        <ImageButton
            android:id="@+id/btn_speed_dec"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/minimize"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_arrow_left" />

        <!-- 中心 GG 图标 -->
        <ImageButton
            android:id="@+id/btn_ball"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/app_name"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_gg" />

        <!-- 加速（右箭头） -->
        <ImageButton
            android:id="@+id/btn_speed_inc"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/minimize"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_arrow_right" />
    </LinearLayout>

    <!-- 速度文本（speedhack 指示） -->
    <TextView
        android:id="@+id/tv_speed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:background="@drawable/speed_bg"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:fontFamily="monospace"
        android:text="1.0x"
        android:textColor="#FFFFFFFF"
        android:textSize="@dimen/text_xs" />

</LinearLayout>
