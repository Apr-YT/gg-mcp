<?xml version="1.0" encoding="utf-8"?>
<!-- 内建数字键盘（任务 §12：4×4 布局：数字/小数/负数/删除/清除/确认） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- 第 1 行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/key_1" style="@style/KeyButton" android:text="1" />
        <Button
            android:id="@+id/key_2" style="@style/KeyButton" android:text="2" />
        <Button
            android:id="@+id/key_3" style="@style/KeyButton" android:text="3" />
        <Button
            android:id="@+id/key_del" style="@style/KeyButton" android:text="←" />
    </LinearLayout>

    <!-- 第 2 行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/key_4" style="@style/KeyButton" android:text="4" />
        <Button
            android:id="@+id/key_5" style="@style/KeyButton" android:text="5" />
        <Button
            android:id="@+id/key_6" style="@style/KeyButton" android:text="6" />
        <Button
            android:id="@+id/key_clear" style="@style/KeyButton" android:text="@string/kb_clear" />
    </LinearLayout>

    <!-- 第 3 行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/key_7" style="@style/KeyButton" android:text="7" />
        <Button
            android:id="@+id/key_8" style="@style/KeyButton" android:text="8" />
        <Button
            android:id="@+id/key_9" style="@style/KeyButton" android:text="9" />
        <Button
            android:id="@+id/key_minus" style="@style/KeyButton" android:text="-" />
    </LinearLayout>

    <!-- 第 4 行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/key_0" style="@style/KeyButton" android:text="0" />
        <Button
            android:id="@+id/key_00" style="@style/KeyButton" android:text="00" />
        <Button
            android:id="@+id/key_dot" style="@style/KeyButton" android:text="." />
        <Button
            android:id="@+id/key_ok" style="@style/KeyAccentButton" android:text="@string/kb_ok" />
    </LinearLayout>

</LinearLayout>
