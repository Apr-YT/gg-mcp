<?xml version="1.0" encoding="utf-8"?>
<!-- GG 风格搜索面板（对应 GG service_searcher）：
     值输入行(符号+值+HEX) / 类型 / 范围 / 模式 / 按钮 / 结果列表 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/spacing_sm"
    android:background="@color/bg">

    <!-- 值输入行：= / 值 / HEX -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_sign"
            android:layout_width="48dp"
            android:layout_height="@dimen/touch_min"
            android:gravity="center"
            android:background="@drawable/btn_dark"
            android:text="="
            android:textColor="@color/text"
            android:textSize="@dimen/text_md"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_value"
            style="@style/Widget.GG.EditText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/spacing_xs"
            android:layout_weight="1"
            android:hint="@string/search_value_hint"
            android:inputType="numberDecimal|numberSigned" />

        <Button
            android:id="@+id/btn_hex"
            android:layout_width="48dp"
            android:layout_height="@dimen/touch_min"
            android:layout_marginLeft="@dimen/spacing_xs"
            android:background="@drawable/btn_dark"
            android:text="HEX"
            android:textColor="@color/text"
            android:textSize="@dimen/text_xs" />
    </LinearLayout>

    <!-- 类型 + 范围 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:orientation="horizontal">

        <Spinner
            android:id="@+id/sp_type"
            android:layout_width="0dp"
            android:layout_height="@dimen/touch_min"
            android:layout_weight="1"
            android:background="@drawable/btn_dark"
            android:paddingLeft="@dimen/spacing_sm"
            android:paddingRight="@dimen/spacing_sm" />

        <Spinner
            android:id="@+id/sp_range"
            android:layout_width="0dp"
            android:layout_height="@dimen/touch_min"
            android:layout_marginLeft="@dimen/spacing_xs"
            android:layout_weight="1"
            android:background="@drawable/btn_dark"
            android:paddingLeft="@dimen/spacing_sm"
            android:paddingRight="@dimen/spacing_sm" />
    </LinearLayout>

    <!-- 搜索模式 -->
    <Spinner
        android:id="@+id/sp_mode"
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_min"
        android:layout_marginTop="@dimen/spacing_xs"
        android:background="@drawable/btn_dark"
        android:paddingLeft="@dimen/spacing_sm"
        android:paddingRight="@dimen/spacing_sm" />

    <!-- 按钮行：新搜索 + 搜索 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_new_search"
            android:layout_width="0dp"
            android:layout_height="@dimen/touch_min"
            android:layout_weight="1"
            android:layout_marginRight="@dimen/spacing_xs"
            android:background="@drawable/btn_dark"
            android:text="@string/new_search"
            android:textColor="@color/text"
            android:textSize="@dimen/text_md" />

        <Button
            android:id="@+id/btn_search"
            android:layout_width="0dp"
            android:layout_height="@dimen/touch_min"
            android:layout_weight="1"
            android:background="@drawable/btn_primary"
            android:text="@string/search"
            android:textColor="@color/on_primary"
            android:textSize="@dimen/text_md"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 结果列表 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/spacing_sm">

        <ListView
            android:id="@+id/list_results"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/divider"
            android:dividerHeight="@dimen/divider_height"
            android:choiceMode="multipleChoice"
            android:fastScrollEnabled="true" />

        <TextView
            android:id="@+id/tv_no_results"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            android:text="@string/no_results"
            android:textColor="@color/text_hint"
            android:textSize="@dimen/text_md" />
    </FrameLayout>

</LinearLayout>
